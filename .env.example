TELEGRAM_BOT_TOKEN=123456:ABC...
# Локальная модель в Ollama
OLLAMA_MODEL=gemma4:e2b-mlx
# Через сколько простоя выгружать модель из памяти
OLLAMA_KEEP_ALIVE=2m
# Кого проверять: * (или пусто) — всех в чате; либо Telegram ID / @username через запятую
WATCHED_USERS=*
# Порог (0-100), с которого бот отвечает на сообщение
SLOP_THRESHOLD=70
# Порог риска суицидальных мыслей (0-100), с которого бот отвечает поддержкой
SELF_HARM_THRESHOLD=60
# Сообщения короче этого числа символов не проверяются
MIN_MESSAGE_LENGTH=60
# Сколько последних сообщений пользователя помнить как образец стиля
STYLE_HISTORY=20
# Сколько проверок может идти одновременно
MAX_CONCURRENT_CHECKS=1
# Доля времени (%), которую модель может работать; остальное — пауза между проверками
LLM_MAX_LOAD=50
# Сколько потоков процессора может занять модель (0 — все)
OLLAMA_NUM_THREAD=4
# Модель рассуждает перед ответом: точнее, но медленнее (on/off)
OLLAMA_THINK=on
# Картинка для ответа на нейрослоп
SLOP_IMAGE=assets/sticker.webp
# Облачная модель вместо локальной (необязательно, API платный):
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# Счётчик любовников и команда /men: on / off
LOVE_COUNTER=on
# Redis (в Docker задаётся в docker-compose.yml; без него — память + файл)
# REDIS_URL=redis://localhost:6379/0
# Ночью бот не использует модель (фразы о суициде ловит и ночью); off — выключить
SLEEP_HOURS=00:00-11:00
# Часовой пояс для SLEEP_HOURS (в Docker по умолчанию UTC)
TZ=Europe/Moscow
